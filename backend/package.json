{
  "name": "baruna-water-level-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "worker": "tsx src/worker.ts",
    "worker:start": "node dist/worker.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:check": "tsx src/cli/db-check.ts",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:seed": "tsx src/cli/seed.ts",
    "user:create": "tsx src/cli/user-create.ts",
    "user:reset-password": "tsx src/cli/user-reset-password.ts",
    "broker:init": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/local/init-dynsec.ps1",
    "broker:local": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/local/start-broker.ps1",
    "broker:ping": "tsx src/cli/broker-ping.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "mqtt": "^5.16.1",
    "pino": "^10.4.0",
    "postgres": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
