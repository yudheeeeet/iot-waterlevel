# Salin menjadi .env lalu isi nilai GANTI_*. File .env TIDAK di-commit.
# Bagian "DEMO" diisi saat menjalankan terhadap Supabase + HiveMQ Cloud (lihat README).

# ── Umum ────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────────
# LOKAL: PostgreSQL 18 di laptop (dibuat dengan deploy/local/create-db.sql)
DATABASE_URL=postgres://baruna:GANTI_PASSWORD_DB@localhost:5432/baruna_dev
# Database khusus test otomatis (dikosongkan & dimigrasi ulang oleh test)
TEST_DATABASE_URL=postgres://baruna:GANTI_PASSWORD_DB@localhost:5432/baruna_test
# DEMO (Supabase): Project Settings → Database → Connection string
#   api di Vercel  : pooler "Transaction" (port 6543)
#   worker/migrasi : pooler "Session" (port 5432)
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Auth (Task 4) ───────────────────────────────────────────────────
# Minimal 32 karakter acak. Contoh membuat: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=GANTI_RAHASIA_MINIMAL_32_KARAKTER
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=7

# ── Broker MQTT ─────────────────────────────────────────────────────
# mosquitto = akun device dibuat otomatis (Dynamic Security) | manual = HiveMQ Cloud (akun dibuat di console)
BROKER_PROVIDER=mosquitto
# LOKAL: Mosquitto proyek di port 1884 (npm run broker:local)
MQTT_URL=mqtt://127.0.0.1:1884
MQTT_USERNAME=baruna-backend
MQTT_PASSWORD=GANTI_PASSWORD_BACKEND_MQTT
# Hanya dipakai script npm run broker:init (lokal), tidak dibaca aplikasi
MQTT_DYNSEC_ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN_DYNSEC
# DEMO (HiveMQ Cloud):
# BROKER_PROVIDER=manual
# MQTT_URL=mqtts://<cluster-id>.s1.eu.hivemq.cloud:8883
# MQTT_USERNAME=baruna-backend
# MQTT_PASSWORD=<password credential backend di HiveMQ>

# ── Cuaca (Task 16) — default sama dengan frontend (Bogor, Kel. Paledang) ──
WEATHER_LOCATION_NAME=Bogor
WEATHER_LAT=-6.595
WEATHER_LON=106.797
WEATHER_BMKG_ADM4=32.71.03.1002
# BMKG_BASE_URL=https://api.bmkg.go.id
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Alamat broker yang ditanam di firmware device (ditampilkan saat membuat device)
# Uji ESP32 dengan npm run broker:lan: isi IP laptop di WiFi (ditampilkan oleh broker:lan), mis. 192.168.43.10
MQTT_PUBLIC_HOST=127.0.0.1
MQTT_PUBLIC_PORT=1884
MQTT_PUBLIC_TLS=false
