# Salin menjadi .env lalu isi. File .env TIDAK di-commit.
# Variabel lain (MQTT, JWT, cuaca, Supabase, HiveMQ) ditambahkan di Task 2 dan seterusnya.

NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# PostgreSQL lokal (PostgreSQL 18 di laptop). Untuk demo diganti URL Supabase.
DATABASE_URL=postgres://baruna:GANTI_PASSWORD@localhost:5432/baruna_dev
