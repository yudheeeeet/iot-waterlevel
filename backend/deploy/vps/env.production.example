# backend/.env untuk VPS (produksi). Salin:  cp deploy/vps/env.production.example .env  lalu ganti semua GANTI_…
# Buat nilai acak dengan:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-40
# File .env TIDAK di-commit (lihat backend/.gitignore).

NODE_ENV=production
LOG_LEVEL=info

# API hanya didengar dari dalam VPS; Nginx (port 80/443) meneruskan /api ke sini.
HOST=127.0.0.1
PORT=8080

# PostgreSQL di VPS yang sama (dibuat oleh deploy/vps/setup-db.sh)
DATABASE_URL=postgres://baruna:GANTI_PASSWORD_DB@127.0.0.1:5432/baruna

# Login
JWT_SECRET=GANTI_MINIMAL_32_KARAKTER_ACAK
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=7
# false selama dashboard masih HTTP (akses lewat IP). WAJIB true setelah HTTPS aktif.
COOKIE_SECURE=false

# Broker Mosquitto di VPS yang sama (akun dibuat otomatis lewat Dynamic Security)
BROKER_PROVIDER=mosquitto
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=baruna-backend
MQTT_PASSWORD=GANTI_PASSWORD_BACKEND_MQTT
# Hanya dipakai deploy/vps/setup-broker.sh, tidak dibaca aplikasi
MQTT_DYNSEC_ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN_DYNSEC

# Alamat broker yang ditampilkan untuk firmware ESP32 saat device dibuat.
# Sekarang IP publik VPS; ganti ke domain (mis. mqtt.domain.com, port 8883, TLS true) setelah ada domain.
MQTT_PUBLIC_HOST=GANTI_IP_PUBLIK_VPS
MQTT_PUBLIC_PORT=1883
MQTT_PUBLIC_TLS=false

# Cuaca (opsional; default Bogor). Isi dengan lokasi sungai yang dipantau.
# WEATHER_LOCATION_NAME=Bogor
# WEATHER_LAT=-6.595
# WEATHER_LON=106.797
# WEATHER_BMKG_ADM4=32.71.03.1002
