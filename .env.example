# ── Data source mode ─────────────────────────────────────────────
# true  = use the built-in mock backend (no server needed)
# false = call the real backend at VITE_API_URL
VITE_USE_MOCK=true

# Backend base URL. Leave empty to use the Vite dev proxy (/api, /ws).
VITE_API_URL=
# Realtime endpoint (WebSocket). Leave empty to derive from VITE_API_URL or the page origin.
VITE_WS_URL=
# Where the Vite dev proxy forwards /api and /ws during development
VITE_BACKEND_PROXY_TARGET=http://localhost:8080

# ── Weather ──────────────────────────────────────────────────────
# direct  = browser fetches BMKG (via /bmkg proxy) + Open-Meteo
# backend = frontend calls GET /api/weather (recommended for production)
VITE_WEATHER_SOURCE=direct

# BMKG kelurahan code (adm4). Default: Kel. Paledang, Kec. Bogor Tengah, Kota Bogor
VITE_BMKG_ADM4=32.71.03.1002
# BMKG base path. In dev this goes through the Vite proxy.
VITE_BMKG_BASE_URL=/bmkg

# Coordinates used for Open-Meteo (days 4–7 and fallback) and the map center
VITE_LOCATION_NAME=Bogor
VITE_LOCATION_LAT=-6.5950
VITE_LOCATION_LON=106.7970

# Polling interval for the dashboard summary when realtime is unavailable (ms)
VITE_POLL_INTERVAL_MS=60000

# ── Branding ────────────────────────────────────────────────────
# Your own logo: put the file in /public (png, jpg, svg, webp) and set its path here.
# Example: public/logo.png  →  VITE_LOGO_URL=/logo.png   (shown at 184×42 px, aspect ratio kept)
VITE_LOGO_URL=
